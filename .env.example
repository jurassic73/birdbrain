# Birdbrain settings for one installation. Copy to .env and fill in:  cp .env.example .env
# .env is gitignored: it holds your camera password and API key, so never commit it.
# Describing your birdbath (location, what's in view, what to ignore) lives on the site's Settings page instead.

# --- Camera (any camera with an RTSP main stream and substream) ---
CAM_HOST=192.168.1.50              # camera IP or hostname
RTSP_PORT=554
RTSP_USER=thingino
RTSP_PASS=                         # set a real password on the camera; the default is publicly known
RTSP_MAIN_PATH=ch0                 # full-resolution stream for ID photos (Thingino: ch0)
RTSP_SUB_PATH=ch1                  # small stream for motion watching (Thingino: ch1)
CAM_API_KEY=                       # Thingino web UI API key, for Settings > Camera (optional)

# --- Claude API (console.anthropic.com) ---
# Use prepaid credits with auto-reload OFF and a small balance (e.g. $20), so a leaked key can only spend that.
# A typical birdbath costs a few dollars a month.
ANTHROPIC_API_KEY=

# --- Where scripts/deploy.sh installs it (a Raspberry Pi on your network) ---
DEPLOY_HOST=192.168.1.20
DEPLOY_USER=pi

# --- Local detector (YOLOX-tiny on the Pi's CPU; download with scripts/get_model.sh) ---
# off    = not used
# shadow = runs on every capture and is recorded, but Claude still sees everything (default; compare on Stats)
# gate   = daytime frames where it finds no animal skip Claude (saves calls in rain/wind; never skips at night)
# DETECTOR=shadow
# DETECTOR_MIN_SCORE=0.15
# Finders that point at the animal for the BioCLIP 2 tight look, tried in this order: motion (the Motion detector's
# circle), blob (the crowd counter's outline), yolox (YOLOX-tiny on the crop box, by day). FINDERS=motion is the old way.
# FINDERS=motion,blob,yolox
# FINDER_YOLOX_MIN_SCORE=0.15   # YOLOX's least class score (bird, cat, dog, ...) for the yolox finder
# Rain on the water: by day, a rim trigger where no finder saw anything new on land and the Pi animal check scored the
# frame under this is kept as a false trigger without asking Claude (gate mode only). 0 turns the rule off.
# RAIN_SCORE_MAX=0.3
# Visit clips: a short video of each real visit, saved as the camera sends it (about 0.5 MB at night, up to 2.5 MB by
# day for 5 seconds at 1080p). CLIP_SECONDS=0 turns clips off. Clips older than CLIP_DAYS are deleted, except those of
# starred visits (favorites and species covers) and the newest CLIP_KEEP_PER_SPECIES of each species, however old;
# CLIP_DAYS=0 keeps them all.
# CLIP_SECONDS=5
# CLIP_DAYS=21
# CLIP_KEEP_PER_SPECIES=10
# Local species classifier: gate (default: a sure daytime guess of a species already settled here names the visit
# without Claude), shadow (record its guess for the Stats scorecard; Claude still decides) or off
# CLASSIFIER=gate
# Gate mode's bars for the top guess: the first look on the Pi animal check's view of the whole bowl, and the tight
# look around the patch that moved, made only when the first look falls short (about 6 s more on a Pi 4)
# GATE_MIN_SCORE_BOWL=0.8
# GATE_MIN_SCORE_TIGHT=0.95
# Shadow second-frame look: when the tight look falls short by score with its top guess at least this sure (by day),
# the next sharpest burst frame is also embedded and both guesses kept to score on Stats; names nothing. 0 or off: never
# SECOND_FRAME_MIN=0.8
# Folder URL of the BioCLIP 2 model release assets; only needed for the first download
CLASSIFIER_RELEASE_URL=
# Local animal check (is anything there?), trained on your labelled frames: off, shadow or gate (skips Claude for
# frames it judges empty; they're kept as false triggers to check). Settings page wins. Needs CLASSIFIER on.
# PRESENCE=shadow
# When the sharpest frame looks empty, the check also scores the burst's last frame and the higher score counts
# (if only the last one shows an animal, it becomes the photo Claude sees). Adds ~6 s on a Pi 4 to empty-looking
# triggers; PRESENCE_LAST_FRAME=0 turns it off.
# PRESENCE_LAST_FRAME=1

# --- Optional integrations ---
# Notifications are configured on the Settings page. NTFY_TOPIC here is not read by the app;
# enter the topic on the Settings page instead.
NTFY_TOPIC=                        # phone alerts via ntfy; the topic name works like a password
ADMIN_PASSWORD=                    # turns on read-only mode: visitors browse, the Admin button logs in to change things (blank = no login, all open)
SITE_URL=                       # base URL of this site (e.g. http://192.168.1.20:8000); adds a tap-to-open link in alerts
SITE_LAT=                          # latitude and longitude of the bath (city-level is fine), e.g. 45.64; for sunrise/sunset recalibration
SITE_LON=                          # e.g. -122.66
# WEATHER=off                      # hourly weather from Open-Meteo (free, no key) is kept whenever SITE_LAT/SITE_LON are set; off skips it
INAT_PLACE_ID=                     # iNaturalist place for local seasonality on species cards, e.g. your county:
                                   # https://api.inaturalist.org/v1/places/autocomplete?q=Clark%20County%2C%20WA (Clark County, WA is 502)
XC_API_KEY=                        # xeno-canto bird sounds on species cards (free account: https://xeno-canto.org/account)

# --- Camera calibration: run `uv run python -m birdbrain.calibrate preview.jpg` and copy the values that fit ---
# Fractions of the frame (0 to 1). Leave unset to watch / send the whole frame.
# MOTION_RING=0.477,0.492,0.133,0.147,0.110,0.113,0.477   # birdbath rim minus the water: cx,cy,outer_rx,outer_ry,inner_rx,inner_ry[,inner_cy]
# MOTION_SPOTS=0.4365,0.4685,0.0365,0.046                 # extra watched spots inside the water (rocks): cx,cy,rx,ry;...
# MOTION_ROI=0.2,0.3,0.6,0.6                              # or a plain rectangle to watch: x,y,w,h
# CROP_ROI=0.3125,0.213,0.33,0.454                        # the part of the photo sent to Claude: x,y,w,h

# --- Birds in the open water (needs MOTION_RING); ignores ripples and raindrops ---
# WATER_WATCH=1             # 0 to watch only the rim and rocks
# WATER_DIFF=40             # how strong a change must be (the rim uses 25)
# WATER_MIN_BLOB=0.01       # bird-sized blob, as a fraction of the water area...
# WATER_MAX_BLOB=0.35       # ...not the whole surface changing at once
# WATER_MIN_SOLIDITY=0.6    # compact shapes only
# WATER_PERSIST_FRAMES=10   # must stay put this many frames (~0.6 s); raindrop rings fade sooner

# --- Ground zone (optional): critters passing by around the bath; draw it with calibrate --ground ---
# GROUND_ZONE=0.22,0.07;0.72,0.03;0.80,0.45;0.98,0.55;0.98,0.98;0.02,0.98;0.02,0.74;0.21,0.58   # corners: x,y;x,y;...
# GROUND_CROP=0.02,0.03,0.96,0.95   # what Claude sees for ground visits: x,y,w,h (default: the box around the zone)
# GROUND_MIN_BLOB=0.003             # by day: blob size as a fraction of the frame (a ground bird)
# GROUND_MIN_BLOB_NIGHT=0.006       # at night: about cat-sized, so moths and splashes don't count
# GROUND_DIFF=20                    # how strong a change must be
# GROUND_PERSIST_FRAMES=8           # must stay in view this many frames (~0.5 s)
# GROUND_MAX_CALLS_PER_DAY=100      # its own cost guard, separate from MAX_CALLS_PER_DAY

# --- Storage ---
# Defaults only; both can be changed on the Settings page, which takes precedence.
# FALSE_TRIGGER_MAX_MB=500     # disk space for false-trigger photos; oldest deleted beyond this (0 = no limit)
# FALSE_TRIGGER_PHOTO=medium   # false-trigger photo size: small, medium, large or full
# Photo budget: all photos, thumbnails and false-trigger bursts together. Over it (or with less free disk than
# DISK_FLOOR_MB) false triggers go first, then older real visits are thinned, then the oldest thinned ones keep only
# their thumbnail. Keepers, species photos, corrected/annotated visits, first sightings and rare species never are.
# PHOTO_BUDGET_MB=10000        # 0 = no budget
# PHOTO_THIN=1                 # thin real visits older than PHOTO_FULL_DAYS (0 = only when over the budget)
# PHOTO_FULL_DAYS=90           # real visits younger than this stay full size
# PHOTO_FULL_PER_DAY=2         # the sharpest photos per species per day that stay full size
# PHOTO_THIN_EDGE=1280         # long edge of a thinned photo: 960, 1280 or 1920 (1920 = keep full size)
# PHOTO_WARN_PCT=80            # one phone alert when photos reach this share of the budget
# RARE_UNDER=10                # every visit of a species seen fewer times than this stays full size
# DISK_FLOOR_MB=5000           # free space to keep on the data disk (0 = don't watch it)
# PHOTO_STAMP=1                # draw the capture time in a pill in each saved photo's bottom-left corner (0 = off);
#                              # turn off the camera's own burn-in timestamp so there's only one
# STAMP_FONT=                  # font file for it; default URW Gothic, then DejaVu Sans Bold (both on Raspberry Pi OS)

# --- Tuning (defaults shown) ---
# MOTION_MIN_AREA=0.004    # fraction of the watched area that must change; ~0.02 with a MOTION_RING
# COOLDOWN_VISIT=60        # seconds to wait after a real visitor
# COOLDOWN_NONE=20         # seconds to wait after a false trigger; doubles with each one in a row...
# COOLDOWN_NONE_MAX=300    # ...up to this, so rain and wind back off instead of calling Claude constantly
# MAX_CALLS_PER_DAY=500    # cost guard
# LIVE_REFRESH=5           # seconds between live-view snapshots

# One visit per stay: new triggers wait until the visitor has left (seconds). STAY=0 turns it off.
# STAY_GAP=30
# STAY_STILL=60
# STAY_MAX=900
# Photos with 2+ separate animal-sized changes from the empty scene go to Claude even when the species gate is sure
# (it names one animal; Claude counts). Changes closer than this many substream px count as one animal.
# GROUP_GAP=8
# COUNT_COLOR=1            # count in colour (a grey animal on the pale rim stays whole); 0 counts in grey
# COLOR_BG_EVERY=3         # substream frames between updates of the colour copy of the empty scene
# Circle from the motion, on visits the Pi names itself (birdbrain/motion_circle.py). CIRCLE_FROM_MOTION=0 turns it off.
# CIRCLE_DIFF=25           # least brightness change from the empty scene that counts
# CIRCLE_MIN_BLOB=0.0005   # fraction of the frame: smaller patches of change are ignored
# CIRCLE_MAX_R=0.13        # of the frame's width: a bigger patch is the light, not an animal
# CIRCLE_AMBIGUOUS=0.6     # a second patch at least this big (of the first): no circle

# Hailo-8 shadow detector (optional, Raspberry Pi AI HAT+; birdbrain/hailo/, service deploy/birdbrain-hailo.service).
# Runs beside the watcher on its own RTSP connection and writes to its own database; it never makes visits.
# HAILO_DETECT=shadow             # off makes the service exit at once
# HAILO_HEF=/usr/share/hailo-models/yolov8s_h8.hef   # a COCO YOLO HEF with its post-process built in (yolov6n_h8.hef is faster)
# HAILO_VIEW=crop                 # crop: the crop box cut from the substream frame, upscaled (finds about twice the
#                                 # visitors of the whole frame); frame: the whole substream frame (sees the ground too)
# HAILO_MIN_SCORE=0.3             # least detection score kept (the HEFs already drop under 0.2)
# HAILO_EVERY=1                   # look at every Nth substream frame
# HAILO_RING_SECONDS=3            # frames kept before an event, so the arrival shots can be saved
# HAILO_EVENT_GAP=2               # seconds unseen before an event ends
# HAILO_MIN_HITS=3                # frames a detection must persist to become an event
# HAILO_SHADOW_DB=                # default DATA_DIR/hailo_shadow.db (never birdbrain.db)
# HAILO_SNAPSHOT_DIR=             # default DATA_DIR/hailo_snapshots
# HAILO_SNAPSHOT_MAX_MB=500       # the oldest event snapshots are deleted beyond this
# HAILO_HEARTBEAT=                # default DATA_DIR/hailo_heartbeat.json (fps, last frame, chip temperature)

# Public read-only mirror (optional): where scripts/push_public.sh sends a copy, and the ssh key it uses.
# The watcher also pushes right after each visit when PUBLIC_DEST is set.
PUBLIC_DEST=                       # e.g. deploy@your-server:   (the server key is locked to rrsync in its data folder)
PUBLIC_KEY=                        # e.g. /home/pi/.ssh/birdbrain_push

# Guests page (admin only, /guests): the public mirror counts anonymous page views, visitors' countries and clicks
# (birdbrain/audience.py), and this site fetches them when you open the page. Set the same long random token on both
# (e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`); unset, the mirror's feed is a 404.
# AUDIENCE_TOKEN=
# AUDIENCE_SOURCE_URL=             # here only: the mirror's feed, e.g. https://example.com/birdbrain/api/audience-counts
# AUDIENCE_DB=                     # the counts file; default DATA_DIR/audience.db. The mirror must keep it outside the
#                                  # pushed data (the Docker image sets /state/audience.db)
# AUDIENCE_COUNT=1                 # on the mirror: 0 stops counting
